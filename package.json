{
  "name": "dsh-cron-scheduler",
  "version": "1.2.2",
  "description": "DSH 全局定时任务插件：5 段 cron 调度执行 bash 命令；任务分级(安全/重要) + 失败微信通知 + 自动重试 + 冒烟测试；设置页管理面板 + Plugins 页卡片 + 模型工具 scheduled_task + 运行时 skill scheduled-tasks。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "README.zh_CN.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmeliaCai67/dsh-cron.git"
  },
  "homepage": "https://github.com/AmeliaCai67/dsh-cron",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cron",
    "scheduler",
    "plugin",
    "定时任务"
  ]
}
